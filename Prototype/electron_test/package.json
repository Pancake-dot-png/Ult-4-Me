{
  "name": "ult-4-me",
  "version": "1.3.0",
  "description": "ULT-4-ME by Pancakes — Overwatch 2 haptic feedback",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --dir"
  },
  "author": "Pancakes",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ws": "^8.20.1"
  },
  "build": {
    "appId": "com.pancakes.ult4me",
    "productName": "ULT-4-ME",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "index.js",
      "app.html",
      "overlay.html",
      "onboarding.html",
      "zone-editor.html",
      "debug.html",
      "launch.vbs",
      "pancake.ico",
      "pancake.png",
      "src/**/*",
      "images/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": "pancake.ico",
      "sign": false
    },
    "forceCodeSigning": false,
    "asar": true,
    "asarUnpack": [
      "src/vision-worker.py",
      "src/capture-screen.py"
    ]
  }
}
