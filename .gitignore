# Keep the repository focused on the maintained V2 application.
# Local legacy folders, tools, design notes, and root build outputs stay local.
/*
!/.gitignore
!/README.md
!/Ult-4-Me v2/
!/.github/

# Installed dependencies and local environments at any depth.
node_modules/
.venv/
venv/
env/
__pycache__/
*.py[cod]

# Generated builds, packages, and caches.
build/
dist/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
htmlcov/
*.spec
*.egg-info/
*.zip
*.receipt.json

# Personal settings, credentials, backups, and logs.
config.json
config.json.*
user_zones.json
window-bounds.json
.env
.env.*
*.pem
*.key
*.bak
*.log

# Editor and operating-system files.
.vscode/
.idea/
.vs/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Temporary capture images.
capture_temp.png
debug_*.png
